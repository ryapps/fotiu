# Copy to .env for local development. These credentials are for local use only.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fotiu?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fotiu?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fotiu_test?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="fotiu"
APP_URL="http://localhost:3000"
STUDIO_TIMEZONE="Asia/Jakarta"
AUTH_SECRET="replace-with-a-random-secret-value"
# Set both values after creating the Google OAuth client.
# AUTH_GOOGLE_ID="your-google-client-id"
# AUTH_GOOGLE_SECRET="your-google-client-secret"
ADMIN_SEED_EMAIL="admin@fotiu.local"
ADMIN_SEED_PASSWORD="replace-with-a-strong-local-password"
