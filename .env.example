# Copy to .env for local development. These credentials are for local use only.
# Local-only example: same user is acceptable for the local development database.
# Production must use a restricted runtime role for DATABASE_URL and a separate
# schema migration role for DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fotiu?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fotiu?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fotiu_test?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="fotiu"
APP_URL="http://localhost:3000"
STUDIO_TIMEZONE="Asia/Jakarta"
# Public studio details shown on the landing page.
# STUDIO_ADDRESS="Studio address"
# STUDIO_CONTACT="WhatsApp number, email, or public contact text"
MIN_LEAD_HOURS="2"
MAX_ADVANCE_DAYS="60"
BOOKING_HOLD_MINUTES="15"
MAX_ACTIVE_HOLDS_PER_USER="2"
CUSTOMER_CANCEL_DEADLINE_HOURS="24"
# Keep the Midtrans Server Key on the server. Sandbox is the default.
# MIDTRANS_SERVER_KEY="replace-with-your-midtrans-sandbox-server-key"
MIDTRANS_ENVIRONMENT="sandbox"
# S3-compatible object storage for admin gallery uploads. Keep credentials server-side.
# Set all STORAGE_* values together. Configure the bucket's CORS for PUT from APP_URL.
# STORAGE_ENDPOINT="https://storage.example.com"
# STORAGE_REGION="auto"
# STORAGE_BUCKET="fotiu-gallery"
# STORAGE_ACCESS_KEY_ID="replace-with-storage-access-key"
# STORAGE_SECRET_ACCESS_KEY="replace-with-storage-secret-key"
# STORAGE_PUBLIC_URL="https://cdn.example.com/fotiu-gallery"
# Uploads accept JPEG/PNG/WebP, max 10 MiB. Bucket objects must be publicly readable.
# Generate a random value of at least 32 characters before enabling the cron endpoint.
# CRON_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
AUTH_SECRET="replace-with-a-random-secret-value"
# Set both values after creating the Google OAuth client.
# AUTH_GOOGLE_ID="your-google-client-id"
# AUTH_GOOGLE_SECRET="your-google-client-secret"
# Local booth agent settings (keep BOOTH_DEVICE_TOKEN on the booth computer only).
# BOOTH_AGENT_BASE_URL="http://localhost:3000"
# BOOTH_DEVICE_ID="studio-booth-01"
# BOOTH_DEVICE_TOKEN="generate-a-random-token-of-at-least-32-characters"
# BOOTH_PROVIDER_KEY="mock"
# BOOTH_MOCK_MODE="success"
# BOOTH_MOCK_DELAY_MS="1000"
# BOOTH_MOCK_COMPLETION_DELAY_MS="3000"
# Optional Photobooth-App adapter settings. See docs/PHOTOBOOTH-APP.md.
# BOOTH_PHOTOBOOTH_APP_URL="http://127.0.0.1:8000"
# BOOTH_PHOTOBOOTH_APP_ACTION="image"
# BOOTH_PHOTOBOOTH_APP_ACTION_INDEX="0"
# BOOTH_PHOTOBOOTH_APP_CALLBACK_TOKEN="generate-a-random-local-token-of-at-least-32-characters"
# BOOTH_PHOTOBOOTH_APP_CALLBACK_PORT="43127"
# BOOTH_POLL_INTERVAL_SECONDS="10"
# BOOTH_HEARTBEAT_TIMEOUT_SECONDS="45"
ADMIN_SEED_EMAIL="admin@fotiu.local"
ADMIN_SEED_PASSWORD="replace-with-a-strong-local-password"
