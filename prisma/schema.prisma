generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  WAITING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum CancelledBy {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum PaymentEventResult {
  PROCESSED
  DUPLICATE
  IGNORED
  REJECTED
}

enum PhotoSessionStatus {
  READY
  STARTING
  ACTIVE
  PROCESSING
  COMPLETED
  FAILED
}

enum PhotoSessionCompletionSource {
  PROVIDER_EVENT
  MANUAL_RECOVERY
}

enum BoothCommandType {
  START_SESSION
}

enum BoothCommandStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum BoothEventType {
  SESSION_STARTED
  SESSION_COMPLETED
  SESSION_FAILED
}

model User {
  id        String    @id @default(cuid())
  googleSub String    @unique
  email     String    @unique
  name      String
  image     String?
  phone     String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  bookings  Booking[]

  @@map("users")
}

model Admin {
  id                     String          @id @default(cuid())
  email                  String          @unique
  passwordHash           String
  name                   String
  isActive               Boolean         @default(true)
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  scheduleBlocks         ScheduleBlock[]
  checkedInBookings      Booking[]       @relation("BookingCheckIn")
  completedPhotoSessions PhotoSession[]  @relation("SessionManualCompletion")
  refundedPayments      Payment[]       @relation("PaymentManualRefund")

  @@map("admins")
}

model AdminLoginAttempt {
  key             String    @id
  failureCount    Int       @default(0)
  windowStartedAt DateTime  @db.Timestamptz(3)
  lockedUntil     DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("admin_login_attempts")
}

model RateLimitBucket {
  key             String   @id
  windowStartedAt DateTime @db.Timestamptz(3)
  count           Int      @default(0)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("rate_limit_buckets")
}

model Package {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  description     String
  price           Int
  durationMinutes Int
  bufferMinutes   Int            @default(0)
  coverImageUrl   String?
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  bookings        Booking[]

  @@index([isActive, sortOrder])
  @@map("packages")
}

model Booking {
  id                  String         @id @default(cuid())
  code                String         @unique
  userId              String
  packageId           String
  packageNameSnapshot String
  priceSnapshot       Int
  startAt             DateTime       @db.Timestamptz(3)
  endAt               DateTime       @db.Timestamptz(3)
  status              BookingStatus
  holdExpiresAt       DateTime?      @db.Timestamptz(3)
  customerNote        String?
  cancelledAt         DateTime?      @db.Timestamptz(3)
  cancelledBy         CancelledBy?
  cancelReason        String?
  completedAt         DateTime?      @db.Timestamptz(3)
  checkedInAt         DateTime?      @db.Timestamptz(3)
  checkedInByAdminId  String?
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)
  user                User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  package             Package        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payment             Payment?
  checkedInByAdmin    Admin?         @relation("BookingCheckIn", fields: [checkedInByAdminId], references: [id], onDelete: SetNull)
  photoSessions       PhotoSession[]

  @@index([userId, startAt])
  @@index([status, startAt])
  @@index([startAt])
  @@map("bookings")
}

model Payment {
  id                    String         @id @default(cuid())
  bookingId             String         @unique
  provider              String
  providerOrderId       String         @unique
  providerTransactionId String?
  amount                Int
  status                PaymentStatus  @default(UNPAID)
  qrString              String?
  qrImageUrl            String?
  expiresAt             DateTime?      @db.Timestamptz(3)
  paidAt                DateTime?      @db.Timestamptz(3)
  refundedAt            DateTime?      @db.Timestamptz(3)
  refundReason          String?
  refundedByAdminId     String?
  refundedByAdmin       Admin?          @relation("PaymentManualRefund", fields: [refundedByAdminId], references: [id], onDelete: Restrict)
  needsReview           Boolean        @default(false)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)
  booking               Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  events                PaymentEvent[]

  @@index([status])
  @@map("payments")
}

model PaymentEvent {
  id             String             @id @default(cuid())
  paymentId      String?
  provider       String
  eventKey       String             @unique
  rawPayload     Json
  signatureValid Boolean
  result         PaymentEventResult
  receivedAt     DateTime           @default(now()) @db.Timestamptz(3)
  payment        Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@map("payment_events")
}

model OperatingHour {
  id        String  @id @default(cuid())
  weekday   Int     @unique
  isOpen    Boolean @default(true)
  openTime  String  @db.VarChar(5)
  closeTime String  @db.VarChar(5)

  @@map("operating_hours")
}

model ScheduleBlock {
  id               String   @id @default(cuid())
  startAt          DateTime @db.Timestamptz(3)
  endAt            DateTime @db.Timestamptz(3)
  reason           String
  createdByAdminId String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  createdByAdmin   Admin?   @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([startAt, endAt])
  @@map("schedule_blocks")
}

model GalleryImage {
  id          String   @id @default(cuid())
  imageUrl    String
  storageKey  String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@map("gallery_images")
}

model Booth {
  id             String         @id @default(cuid())
  name           String
  deviceId       String         @unique
  providerKey    String         @db.VarChar(40)
  agentTokenHash String         @unique
  isMaintenance  Boolean        @default(false)
  lastSeenAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  photoSessions  PhotoSession[]
  commands       BoothCommand[]
  events         BoothEvent[]

  @@index([lastSeenAt])
  @@map("booths")
}

model PhotoSession {
  id                 String                        @id @default(cuid())
  bookingId          String
  boothId            String
  providerKey        String                        @db.VarChar(40)
  providerSessionId  String?
  status             PhotoSessionStatus            @default(READY)
  startedAt          DateTime?                     @db.Timestamptz(3)
  completedAt        DateTime?                     @db.Timestamptz(3)
  failedAt           DateTime?                     @db.Timestamptz(3)
  completionSource   PhotoSessionCompletionSource?
  completionReason   String?
  completedByAdminId String?
  createdAt          DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                      @updatedAt @db.Timestamptz(3)
  booking            Booking                       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  booth              Booth                         @relation(fields: [boothId], references: [id], onDelete: Restrict)
  completedByAdmin   Admin?                        @relation("SessionManualCompletion", fields: [completedByAdminId], references: [id], onDelete: Restrict)
  commands           BoothCommand[]
  events             BoothEvent[]

  @@unique([id, boothId])
  @@index([bookingId, createdAt])
  @@index([boothId, status, createdAt])
  @@map("photo_sessions")
}

model BoothCommand {
  id             String             @id @default(cuid())
  boothId        String
  photoSessionId String
  type           BoothCommandType
  status         BoothCommandStatus @default(PENDING)
  idempotencyKey String             @unique
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  executedAt     DateTime?          @db.Timestamptz(3)
  failedAt       DateTime?          @db.Timestamptz(3)
  errorMessage   String?
  booth          Booth              @relation(fields: [boothId], references: [id], onDelete: Restrict)
  photoSession   PhotoSession       @relation(fields: [photoSessionId, boothId], references: [id, boothId], onDelete: Restrict)

  @@unique([photoSessionId, type], map: "booth_commands_one_type_per_session_key")
  @@index([boothId, status, createdAt])
  @@map("booth_commands")
}

model BoothEvent {
  id             String         @id @default(cuid())
  eventId        String         @unique
  boothId        String
  photoSessionId String
  type           BoothEventType
  occurredAt     DateTime       @db.Timestamptz(3)
  receivedAt     DateTime       @default(now()) @db.Timestamptz(3)
  booth          Booth          @relation(fields: [boothId], references: [id], onDelete: Restrict)
  photoSession   PhotoSession   @relation(fields: [photoSessionId, boothId], references: [id, boothId], onDelete: Restrict)

  @@index([photoSessionId, occurredAt])
  @@map("booth_events")
}
